        {
          "key": "allow_indexed",
          "type": "switch",
          "labelKey": "settings.allow_indexed",
          "helpKey": "settings.allow_indexed-tips",
          "defaultValue": false
        },
        {
          "key": "allow_mounted",
          "type": "switch",
          "labelKey": "settings.allow_mounted",
          "helpKey": "settings.allow_mounted-tips",
          "defaultValue": true
        },
        {
          "key": "announcement",
          "type": "textarea",
          "labelKey": "settings.announcement",
          "helpKey": "settings.announcement-tips"
        },
        {
          "key": "robots_txt",
          "type": "code",
          "labelKey": "settings.robots_txt",
          "helpKey": "settings.robots_txt-tips"
        }
      ]
    }
